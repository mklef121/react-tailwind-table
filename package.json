{
  "name": "react-tailwind-table",
  "version": "1.2.2",
  "description": "A Responsive Table component Made with React js and Tailwind Css. Has Pagination and search ability.",
  "author": "mklef121",
  "license": "MIT",
  "repository": "mklef121/react-tailwind-table",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.tsx",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production microbundle-crl --css-modules false --format modern,cjs",
    "start": "microbundle-crl watch --css-modules false --no-compress --format modern,cjs",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit && npm run test:build",
    "test:build": "npm run build",
    "test:unit": "cross-env CI=1 react-scripts test --env=jsdom --coverage=true",
    "test:watch": "react-scripts test --env=jsdom",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/build",
    "tailwind-build": "postcss ./src/css/tailwind-setup.css -o ./src/css/output.css",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "react": "^17.0.2"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss7-compat": "^2.0.4",
    "@types/jest": "^25.1.4",
    "@types/react": "^17.0.2",
    "autoprefixer": "^9.8.6",
    "cross-env": "^7.0.2",
    "gh-pages": "^6.3.0",
    "microbundle-crl": "^0.13.10",
    "postcss": "^7.0.35",
    "postcss-cli": "^7.1.1",
    "prettier": "^2.0.4",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-scripts": "^3.4.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.0.4"
  },
  "files": [
    "dist"
  ],
  "release": {
    "repositoryUrl": "git@github.com:mklef121/react-tailwind-table.git",
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
